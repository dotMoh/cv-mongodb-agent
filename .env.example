# Copy to .env (never commit .env). Read by agent/config.py, data/ scripts and `python dev.py live`.
# Keep comments on their own lines: some loaders don't strip inline comments.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATA_SOURCE=mongo
DB_NAME=outage_agent
LESSONS_COLLECTION=lessons
AUDIT_COLLECTION=audit_log
SCHEDULES_COLLECTION=schedules
LESSON_VECTOR_INDEX=lesson_vector_index
EMBEDDINGS=minilm
# Set LLM_MODE=fallback on stage if Ollama is slow
LLM_MODE=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=25
DRAFT_EXPIRY_DAYS=30
FORGET_POLICY=tombstone
